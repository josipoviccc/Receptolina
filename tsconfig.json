{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "paths": {
      "@components": ["./components&/*"]
    }
  },
  "include": ["src"]
}